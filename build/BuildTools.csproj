<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(TerminatorLatestTargetFramework)</TargetFramework>
        <!-- Output to bin/<Config>/ without a framework folder, so the run scripts need no update on .NET upgrades. -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- CliWrap, CommandDotNet and Microsoft.Extensions.DependencyInjection come from the
             Terminator project reference. Don't repeat them here: a second, older version
             causes NU1605 whenever Dependabot bumps the library. The same goes for Spectre.Console. -->
        <PackageReference Include="Spectre.Console.Analyzer" Version="1.0.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../src/Terminator.csproj" />
    </ItemGroup>

</Project>