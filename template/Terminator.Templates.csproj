<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Terminator.Templates</PackageId>
    <Title>Terminator Templates</Title>
    <Authors>StudioAvw</Authors>
    <Description>Templates for the Terminator CLI tool.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dotnet-new;templates;terminator</PackageTags>
    <RepositoryUrl>https://github.com/arendvw/Terminator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>$(TerminatorLatestTargetFramework)</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <!-- NU5110: run.ps1 ships as template content, not as an install script. -->
    <NoWarn>$(NoWarn);NU5128;NU5111;NU5110</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- Version is derived from the git tag by MinVer (see PackageReference below). -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <Content Include="Builder\**\*" Exclude="Builder\**\bin\**;Builder\**\obj\**" />
    <Content Include="Simple\**\*" Exclude="Simple\**\bin\**;Simple\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>
</Project>